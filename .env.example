# Porta do BFF (padrão 3000).
PORT=3000

# URLs base dos destinos: obrigatórias, sem valor padrão. Os valores abaixo são exemplos para rodar tudo na máquina local.
RULES_SERVICE_URL=http://localhost:3001
DECISIONS_SERVICE_URL=http://localhost:3002
# Função local (Azure Functions Core Tools); no Azure, use https://<function-app>.azurewebsites.net
FUNCTION_URL=http://localhost:7071

# Chave da Function (header x-functions-key). Só no servidor: nunca aparece em resposta, log nem Swagger.
# Sem valor, a chave não é enviada (adequado só à Function local).
FUNCTION_KEY=

# Tempo limite por chamada a cada destino, em milissegundos (padrão 5000).
UPSTREAM_TIMEOUT_MS=5000

# Origens permitidas no CORS, separadas por vírgula. Sem valor, o CORS fica desligado.
CORS_ORIGIN=http://localhost:5173
